# School Self-Evaluation – production settings (installed as /etc/sse/sse.env)

# Only reachable through Caddy on the same server
HOST=127.0.0.1
PORT=5050

# Caddy sits in front: take the visitor's IP from X-Forwarded-For (per-visitor rate limits)
TRUST_PROXY=true

# Served over HTTPS: secure cookies + HSTS
HTTPS=true

# Database, session key and first-login file live here – this is what gets backed up
DATA_DIR=/var/lib/sse

TZ_NAME=Africa/Johannesburg
NODE_ENV=production
